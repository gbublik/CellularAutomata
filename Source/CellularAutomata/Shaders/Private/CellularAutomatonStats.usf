// Сводка по объёму GPU-сессии (FGpuResidentSimulation): число живых клеток и
// их габарит. Единственное, что заход GPU-сессии читает обратно на CPU -
// 32 байта вместо всей сетки.
//
// Поток на слово битовой плоскости. Слово может накрывать несколько строк
// (VolumeDim.x не обязан быть кратен 32, а при узком объёме меньше 32), так
// что координаты считаются по каждому установленному биту, а не по слову.
//
// OutputStats (8 uint, обнуляются перед проходом):
//   [0]     число живых
//   [1..3]  max(Dim - 1 - coord) по x, y, z  - то есть минимум, но через Max,
//           чтобы весь буфер обнулялся одной очисткой
//   [4..6]  max(coord) по x, y, z
//   [7]     число непустых групп (диагностика; 0 - объём пуст)

#include "/Engine/Public/Platform.ush"

uint3 VolumeDim;
uint WordCount;
StructuredBuffer<uint> InputBits;
RWStructuredBuffer<uint> OutputStats;

#define GROUP_SIZE 64

groupshared uint GroupStats[8];

[numthreads(GROUP_SIZE, 1, 1)]
void MainCS(uint3 GroupId : SV_GroupID, uint GroupIndex : SV_GroupIndex, uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (GroupIndex < 8)
	{
		GroupStats[GroupIndex] = 0;
	}
	GroupMemoryBarrierWithGroupSync();

	// Плоский индекс слова по сетке групп: диспатч может быть раскатан в две
	// размерности, если слов больше 65535 * GROUP_SIZE.
	const uint WordIndex = (GroupId.y * 65535u + GroupId.x) * GROUP_SIZE + GroupIndex;

	uint Count = 0;
	uint3 InvMin = uint3(0, 0, 0);
	uint3 Max = uint3(0, 0, 0);

	if (WordIndex < WordCount)
	{
		uint Word = InputBits[WordIndex];
		Count = countbits(Word);
		const uint PlaneXY = VolumeDim.x * VolumeDim.y;
		while (Word != 0)
		{
			const uint Bit = firstbitlow(Word);
			const uint CellIndex = WordIndex * 32u + Bit;
			const uint3 Coord = uint3(CellIndex % VolumeDim.x, (CellIndex / VolumeDim.x) % VolumeDim.y, CellIndex / PlaneXY);
			InvMin = max(InvMin, (VolumeDim - 1u) - Coord);
			Max = max(Max, Coord);
			Word &= Word - 1u;
		}
	}

	if (Count != 0)
	{
		InterlockedAdd(GroupStats[0], Count);
		InterlockedMax(GroupStats[1], InvMin.x);
		InterlockedMax(GroupStats[2], InvMin.y);
		InterlockedMax(GroupStats[3], InvMin.z);
		InterlockedMax(GroupStats[4], Max.x);
		InterlockedMax(GroupStats[5], Max.y);
		InterlockedMax(GroupStats[6], Max.z);
	}
	GroupMemoryBarrierWithGroupSync();

	if (GroupIndex == 0 && GroupStats[0] != 0)
	{
		InterlockedAdd(OutputStats[0], GroupStats[0]);
		InterlockedMax(OutputStats[1], GroupStats[1]);
		InterlockedMax(OutputStats[2], GroupStats[2]);
		InterlockedMax(OutputStats[3], GroupStats[3]);
		InterlockedMax(OutputStats[4], GroupStats[4]);
		InterlockedMax(OutputStats[5], GroupStats[5]);
		InterlockedMax(OutputStats[6], GroupStats[6]);
		InterlockedAdd(OutputStats[7], 1u);
	}
}
