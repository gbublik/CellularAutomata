// Один шаг 3D клеточного автомата: для каждой клетки в VolumeDim считаем
// живых соседей по NeighborOffsets и решаем рождение/выживание по
// BirthMask/SurvivalMask (бит i = разрешено i живых соседей).
// Зеркалит FCpuComputeStrategy::Step() (см. CpuComputeStrategy.cpp) -
// клетки за пределами буфера трактуются как мёртвые, что соответствует
// CPU-семантике: клетка вне halo от любой живой клетки не может родиться.

#include "/Engine/Public/Platform.ush"

uint3 VolumeDim;
uint NeighborOffsetCount;
int4 NeighborOffsets[26];
uint BirthMask;
uint SurvivalMask;
// bDecayActive==0 - Generations выключен (States==2, подавляющее большинство
// правил) - IsDecayingAt() ниже никогда не вызывается, InputDecayBits в этом
// случае привязан C++-стороной на тот же буфер, что InputBits (см.
// FGpuComputeStrategy::Step()) - безопасно, шейдер его не разыменовывает.
uint bDecayActive;
// bTrackAges==0 - возрасты считает CPU (CellAging::ComputeAges) после шага,
// как и раньше; InputAges/OutputAges в этом случае привязаны C++-стороной к
// буферам-заглушкам в одно слово, и ветка ниже к ним не обращается. ==1 -
// шаг идёт внутри пачки (FGpuComputeStrategy::StepBatch()), промежуточных
// поколений на CPU не будет вовсе, поэтому возраст надо вести здесь.
uint bTrackAges;

StructuredBuffer<uint> InputBits;
StructuredBuffer<uint> InputDecayBits;
// Возраст - байт на клетку (4 клетки в слове), насыщение на 255: тот же тип
// и та же семантика, что у FCellGrid::GetAge()/SetAge().
StructuredBuffer<uint> InputAges;
RWStructuredBuffer<uint> OutputBits;
RWStructuredBuffer<uint> OutputAges;

uint CellIndex(int3 Coord)
{
	return (uint)((Coord.z * (int)VolumeDim.y + Coord.y) * (int)VolumeDim.x + Coord.x);
}

bool IsAliveAt(int3 Coord)
{
	if (any(Coord < 0) || any(Coord >= int3(VolumeDim)))
	{
		return false;
	}
	uint Index = CellIndex(Coord);
	return (InputBits[Index >> 5] >> (Index & 31u)) & 1u;
}

// Зеркалит IsAliveAt(), но читает InputDecayBits - "клетка сейчас угасает"
// (см. FCellGrid::IsDecaying()). Клетка за пределами буфера не угасает
// (false), тем же соображением, что и IsAliveAt().
bool IsDecayingAt(int3 Coord)
{
	if (any(Coord < 0) || any(Coord >= int3(VolumeDim)))
	{
		return false;
	}
	uint Index = CellIndex(Coord);
	return (InputDecayBits[Index >> 5] >> (Index & 31u)) & 1u;
}

[numthreads(4, 4, 4)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId >= VolumeDim))
	{
		return;
	}

	int3 Coord = int3(DispatchThreadId);
	uint AliveNeighbors = 0;
	for (uint i = 0; i < NeighborOffsetCount; ++i)
	{
		if (IsAliveAt(Coord + NeighborOffsets[i].xyz))
		{
			++AliveNeighbors;
		}
	}

	bool bAlive = IsAliveAt(Coord);
	// Угасающая (birth-immune) клетка не может родиться заново, даже если у
	// неё оказалось подходящее число живых соседей - зеркалит
	// FCpuComputeStrategy::Step()'s bDecayActive-ветку.
	bool bDecaying = (bDecayActive != 0) && IsDecayingAt(Coord);
	bool bNextAlive = bAlive ? ((SurvivalMask >> AliveNeighbors) & 1u) != 0
	                 : (bDecaying ? false : ((BirthMask >> AliveNeighbors) & 1u) != 0);

	if (bNextAlive)
	{
		uint Index = CellIndex(Coord);
		InterlockedOr(OutputBits[Index >> 5], 1u << (Index & 31u));

		if (bTrackAges != 0)
		{
			// Зеркалит CellAging::ComputeAges(): выжившая клетка получает
			// возраст предыдущего поколения + 1 (с насыщением), только что
			// родившаяся - 0. Буфер очищен нулями перед проходом, поэтому
			// нулевой возраст просто не пишется.
			uint ByteShift = (Index & 3u) * 8u;
			uint OldAge = bAlive ? ((InputAges[Index >> 2] >> ByteShift) & 0xFFu) : 0u;
			uint NewAge = bAlive ? min(OldAge + 1u, 255u) : 0u;
			if (NewAge != 0u)
			{
				// InterlockedOr, а не обычная запись: в одном слове живут 4
				// клетки, и их считают разные потоки - но байты у них разные,
				// а слово обнулено, так что OR корректен (та же причина, что и
				// у OutputBits выше).
				InterlockedOr(OutputAges[Index >> 2], NewAge << ByteShift);
			}
		}
	}
}
